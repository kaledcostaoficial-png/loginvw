# MODELO de configuração — copie este arquivo para ".env" e preencha com os valores reais.
# NÃO coloque valores reais aqui neste arquivo (ele vai pro histórico do projeto).

# URL do seu projeto no Supabase (ex.: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave pública "anon" do Supabase (pode aparecer no navegador, é segura para isso)
SUPABASE_ANON_KEY=

# ATENÇÃO: a chave "service_role" (de administrador) NÃO vai aqui.
# Ela é secreta e só será usada dentro das Edge Functions, na Fase 2.
